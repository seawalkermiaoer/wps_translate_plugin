<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnAddinLoad">
  <ribbon>
    <tabs>
      <tab id="AITranslateTab" getLabel="GetRibbonLabel">
        <group id="translateGroup" getLabel="GetRibbonLabel">
          <button
            id="btnTranslateDoc"
            getLabel="GetRibbonLabel"
            size="large"
            onAction="OnTranslateClick"
            image="btnIcon">
            <supertip>
              <title>AI Full Document Translation</title>
              <description>Translate the entire document from Chinese to English using AI, while preserving all text formatting such as bold, italic, colors, and underline.</description>
            </supertip>
          </button>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
