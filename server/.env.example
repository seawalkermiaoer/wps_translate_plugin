# WPS AI Translation Server - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================
# LLM API Configuration
# ============================

# Your LLM API Key (REQUIRED)
LLM_API_KEY=your_api_key_here

# OpenAI-compatible base URL (default: Alibaba DashScope)
# Examples:
#   - DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - OpenAI:    https://api.openai.com/v1
#   - Anthropic: (requires separate adapter)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model identifier
# Examples: qwen-plus, qwen-turbo, qwen-max, gpt-4o, gpt-4-turbo
LLM_MODEL=qwen-plus

# ============================
# Server Configuration
# ============================

# HTTP server port (default: 3000)
PORT=3000

# ============================
# Translation Configuration
# ============================

# Maximum retry attempts per paragraph when tag validation fails (default: 3)
MAX_RETRIES=3

# Maximum characters per chunk (informational; client uses this guideline)
MAX_CHUNK_CHARS=1500
